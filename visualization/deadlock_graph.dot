digraph Deadlocks {
    rankdir=LR;
    M0 [label="M0\nP1=1, P2=0, P3=0, P4=0" style=filled, fillcolor="#ccffcc"];
    M1 [label="M1\nP1=0, P2=1, P3=0, P4=0" ];
    M2 [label="M2\nP1=0, P2=0, P3=1, P4=0" ];
    M3 [label="M3\nP1=0, P2=0, P3=0, P4=1" style=filled, fillcolor="#ffcccc"];
    M0 -> M1 [label="T1"];
    M0 -> M2 [label="T3"];
    M1 -> M3 [label="T2"];
    M2 -> M3 [label="T4"];
}