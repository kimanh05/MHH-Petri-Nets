digraph PetriNet {
    rankdir=LR;
    node [fontsize=12];
    "P0" [shape=circle, label="P0 (1)"];
    "P1" [shape=circle, label="P1"];
    "P2" [shape=circle, label="P2"];
    "P3" [shape=circle, label="P3"];
    "P4" [shape=circle, label="P4"];
    "P5" [shape=circle, label="P5"];
    "P6" [shape=circle, label="P6"];
    "P7" [shape=circle, label="P7"];
    "P8" [shape=circle, label="P8"];
    "P9" [shape=circle, label="P9"];
    "T1" [shape=box, style=filled, fillcolor="#eeeeee"];
    "T2" [shape=box, style=filled, fillcolor="#eeeeee"];
    "T3" [shape=box, style=filled, fillcolor="#eeeeee"];
    "T4" [shape=box, style=filled, fillcolor="#eeeeee"];
    "T5" [shape=box, style=filled, fillcolor="#eeeeee"];
    "T6" [shape=box, style=filled, fillcolor="#eeeeee"];
    "T7" [shape=box, style=filled, fillcolor="#eeeeee"];
    "T8" [shape=box, style=filled, fillcolor="#eeeeee"];
    "T9" [shape=box, style=filled, fillcolor="#eeeeee"];
    "T10" [shape=box, style=filled, fillcolor="#eeeeee"];
    "P0" -> "T1";
    "T1" -> "P1";
    "T1" -> "P2";
    "P1" -> "T2";
    "T2" -> "P3";
    "P2" -> "T3";
    "T3" -> "P4";
    "P3" -> "T4";
    "T4" -> "P5";
    "P4" -> "T5";
    "T5" -> "P6";
    "P5" -> "T6";
    "P6" -> "T6";
    "T6" -> "P7";
    "P7" -> "T7";
    "T7" -> "P8";
    "P8" -> "T8";
    "T8" -> "P9";
    "P9" -> "T9";
    "T9" -> "P0";
    "P3" -> "T10";
    "T10" -> "P2";
}