<?xml version="1.0" encoding="UTF-8"?>
<pnml>
  <net id="tc18" type="http://www.pnml.org/version-2009/grammar/ptnet">

    <place id="S"><initialMarking><text>1</text></initialMarking></place>
    <place id="A"><initialMarking><text>0</text></initialMarking></place>
    <place id="B"><initialMarking><text>0</text></initialMarking></place>
    <place id="J"><initialMarking><text>0</text></initialMarking></place>

    <transition id="Tsplit1"/>
    <transition id="Tsplit2"/>
    <transition id="Tjoin"/>

    <!-- OR-Split -->
    <arc id="a1" source="S" target="Tsplit1"/>
    <arc id="a2" source="S" target="Tsplit2"/>
    <arc id="a3" source="Tsplit1" target="A"/>
    <arc id="a4" source="Tsplit2" target="B"/>

    <!-- AND Join -->
    <arc id="a5" source="A" target="Tjoin"/>
    <arc id="a6" source="B" target="Tjoin"/>
    <arc id="a7" source="Tjoin" target="J"/>

  </net>
</pnml>
