<?xml version="1.0" encoding="UTF-8"?>
<pnml>
  <net id="tc7" type="http://www.pnml.org/version-2009/grammar/ptnet">

    <place id="P0"><initialMarking><text>1</text></initialMarking></place>

    <place id="P1"><initialMarking><text>0</text></initialMarking></place>

    <transition id="T1"/>
    <arc id="a1" source="P0" target="T1"/>
    <arc id="a2" source="T1" target="P0"/>

    <!-- unreachable disconnected sub-net -->
    <place id="Q0"><initialMarking><text>0</text></initialMarking></place>
    <transition id="Q1"/>
    <arc id="a3" source="Q0" target="Q1"/>

  </net>
</pnml>
