<?xml version="1.0" encoding="UTF-8"?>
<pnml>
  <net id="tc12" type="http://www.pnml.org/version-2009/grammar/ptnet">

    <place id="A"><initialMarking><text>1</text></initialMarking></place>
    <place id="B"><initialMarking><text>0</text></initialMarking></place>
    <place id="C"><initialMarking><text>0</text></initialMarking></place>

    <transition id="T1"/>
    <transition id="T2"/>

    <arc id="a1" source="A" target="T1"/>
    <arc id="a2" source="T1" target="B"/>

    <arc id="a3" source="B" target="T2"/>
    <arc id="a4" source="T2" target="C"/>

    <!-- no transition returns token to A => siphon drain -->
  </net>
</pnml>
